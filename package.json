{
  "name": "lmboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:data && next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "tsx scripts/validate-data.ts",
    "discover:models": "tsx scripts/discover-models.ts"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.19.7",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "tsx": "4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
