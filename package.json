{
  "name": "lmboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:data && next build",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
